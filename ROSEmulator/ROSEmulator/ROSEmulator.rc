#include "resource.h"
#include <afxres.h>
IDD_MAIN DIALOGEX 0,0,500,300
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ROSEmulator - Loopback UDP ROS 8021 / Handler 8020"
FONT 9,"Tahoma"
BEGIN
 LTEXT "ROS IP : 8021",-1,10,12,80,12
 EDITTEXT IDC_LOCAL,95,10,110,14,ES_AUTOHSCROLL
 LTEXT "Handler IP : 8020",-1,220,12,75,12
 EDITTEXT IDC_HANDLER,300,10,110,14,ES_AUTOHSCROLL
 LTEXT "Delay min / max (ms)",-1,10,37,115,12
 EDITTEXT IDC_MIN,130,35,55,14,ES_NUMBER
 EDITTEXT IDC_MAX,195,35,55,14,ES_NUMBER
 LTEXT "G % / N % (R = remainder)",-1,260,37,145,12
 EDITTEXT IDC_GOOD,405,35,35,14,ES_NUMBER
 EDITTEXT IDC_NG,450,35,35,14,ES_NUMBER
 COMBOBOX IDC_MODE,10,60,140,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "Start",IDC_START,160,60,65,18
 PUSHBUTTON "Stop",IDC_STOP,235,60,65,18
 PUSHBUTTON "Connect request",IDC_CONNECT,310,60,100,18
 LTEXT "Stopped",IDC_STATE,10,87,475,15
 LISTBOX IDC_LOG,10,105,480,185,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_TABSTOP
END
